// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
}

enum MaterialType {
  NOTE
  VIDEO
  YOUTUBE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  role          Role      @default(STUDENT)
  image         String?
  degree        String?   // For teachers
  subjects      String?   // For teachers (comma separated or JSON)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Teacher relationships
  taughtClasses Class[]   @relation("TeacherClasses")
  notices       Notice[]  @relation("TeacherNotices")
  
  // Student relationships
  enrollments   Enrollment[]
}

model Class {
  id          String       @id @default(cuid())
  name        String
  description String?
  thumbnail   String?
  teacherId   String
  teacher     User         @relation("TeacherClasses", fields: [teacherId], references: [id])
  materials   Material[]
  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Material {
  id          String       @id @default(cuid())
  title       String
  description String?
  type        MaterialType
  url         String       // Link to file or YouTube URL
  classId     String
  class       Class        @relation(fields: [classId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id])
  classId   String
  class     Class     @relation(fields: [classId], references: [id])
  status    String   @default("active") // e.g., active, completed
  createdAt DateTime @default(now())

  @@unique([studentId, classId])
}

model Notice {
  id        String   @id @default(cuid())
  content   String
  teacherId String
  teacher   User     @relation("TeacherNotices", fields: [teacherId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
